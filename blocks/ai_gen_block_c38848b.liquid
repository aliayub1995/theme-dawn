{% doc %}
  @prompt
    I want to add a section in the theme, Which shows customer reviews that we have uptill now and upcoming reviews and star rating. Just randomly show the reviews, Make it a repeating carousel. And add some more reviews, The arrows and dots underneath are taking too much space. Remove them and keep the reviews rolling automatically. Plus make this section a little compact., Since this store is for Pakistan only. Make the english simple and asian style. Plus add a few reviews in roman english like this "Zabardast watch, main ne apne husband ke liye buy ki and he liked it. delivery was on time as well. Thank you"
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-reviews-carousel__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-reviews-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 30px;
  }

  .ai-reviews-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px;
  }

  .ai-reviews-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-reviews-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-reviews-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform 0.5s ease;
  }

  .ai-reviews-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - {{ block.settings.card_gap | times: 2 | divided_by: 3 }}px);
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-reviews-carousel__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }

  .ai-reviews-carousel__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-reviews-carousel__star-{{ ai_gen_id }}.empty {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-reviews-carousel__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.review_text_color }};
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .ai-reviews-carousel__author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-reviews-carousel__avatar-{{ ai_gen_id }} {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: {{ block.settings.avatar_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    color: {{ block.settings.avatar_text_color }};
    font-size: 14px;
    flex-shrink: 0;
  }

  .ai-reviews-carousel__author-info-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-reviews-carousel__author-name-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.author_name_color }};
    margin: 0 0 3px;
    font-size: 14px;
  }

  .ai-reviews-carousel__author-date-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.author_date_color }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-reviews-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - {{ block.settings.card_gap | divided_by: 2 }}px);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-reviews-carousel__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-reviews-carousel__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<customer-reviews-{{ ai_gen_id }} class="ai-reviews-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-reviews-carousel__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-reviews-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-reviews-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-reviews-carousel__wrapper-{{ ai_gen_id }}">
      <div class="ai-reviews-carousel__track-{{ ai_gen_id }}" data-track>
        {% for i in (1..12) %}
          {% liquid
            assign review_enabled_key = 'review_' | append: i | append: '_enabled'
            assign review_text_key = 'review_' | append: i | append: '_text'
            assign review_author_key = 'review_' | append: i | append: '_author'
            assign review_date_key = 'review_' | append: i | append: '_date'
            assign review_rating_key = 'review_' | append: i | append: '_rating'

            assign review_enabled = block.settings[review_enabled_key]
            assign review_text = block.settings[review_text_key]
            assign review_author = block.settings[review_author_key]
            assign review_date = block.settings[review_date_key]
            assign review_rating = block.settings[review_rating_key]
          %}

          {% if review_enabled %}
            <div class="ai-reviews-carousel__card-{{ ai_gen_id }}">
              <div class="ai-reviews-carousel__stars-{{ ai_gen_id }}">
                {% for star in (1..5) %}
                  {% if star <= review_rating %}
                    <svg class="ai-reviews-carousel__star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% else %}
                    <svg class="ai-reviews-carousel__star-{{ ai_gen_id }} empty" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% endif %}
                {% endfor %}
              </div>

              {% if review_text != blank %}
                <p class="ai-reviews-carousel__text-{{ ai_gen_id }}">{{ review_text }}</p>
              {% endif %}

              <div class="ai-reviews-carousel__author-{{ ai_gen_id }}">
                {% if review_author != blank %}
                  <div class="ai-reviews-carousel__avatar-{{ ai_gen_id }}">
                    {{ review_author | slice: 0 | upcase }}
                  </div>
                  <div class="ai-reviews-carousel__author-info-{{ ai_gen_id }}">
                    <p class="ai-reviews-carousel__author-name-{{ ai_gen_id }}">{{ review_author }}</p>
                    {% if review_date != blank %}
                      <p class="ai-reviews-carousel__author-date-{{ ai_gen_id }}">{{ review_date }}</p>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</customer-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomerReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.cards = Array.from(this.track.querySelectorAll('.ai-reviews-carousel__card-{{ ai_gen_id }}'));

        if (this.cards.length === 0) return;

        this.cloneCards();
        this.updateCarousel(false);
        this.startAutoplay();
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }

      cloneCards() {
        const clonedStart = this.cards.map(card => card.cloneNode(true));
        const clonedEnd = this.cards.map(card => card.cloneNode(true));
        
        clonedEnd.forEach(card => this.track.appendChild(card));
        clonedStart.reverse().forEach(card => this.track.insertBefore(card, this.track.firstChild));
        
        this.allCards = Array.from(this.track.querySelectorAll('.ai-reviews-carousel__card-{{ ai_gen_id }}'));
        this.currentIndex = this.cards.length;
      }

      next() {
        this.currentIndex++;
        this.updateCarousel(true);
      }

      updateCarousel(animate) {
        const cardWidth = this.allCards[0].offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const offset = -this.currentIndex * (cardWidth + gap);

        if (animate) {
          this.track.style.transition = 'transform 0.5s ease';
        } else {
          this.track.style.transition = 'none';
        }

        this.track.style.transform = `translateX(${offset}px)`;

        if (animate) {
          this.track.addEventListener('transitionend', () => {
            if (this.currentIndex >= this.cards.length * 2) {
              this.currentIndex = this.cards.length;
              this.updateCarousel(false);
            }
          }, { once: true });
        }
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.next();
        }, {{ block.settings.autoplay_speed | times: 1000 }});
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('customer-reviews-{{ ai_gen_id }}', CustomerReviews{{ ai_gen_id }});
  })();
</script>

